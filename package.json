{
  "name": "outreach-intelligence",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "check:no-raw-http": "tsx tools/check-no-raw-http.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:reset": "prisma migrate reset --force",
    "test": "npm run check:no-raw-http && vitest run",
    "test:watch": "vitest",
    "verify:f0": "tsx tools/verify-f0.ts",
    "seed:hosts": "tsx tools/seed-host-policies.ts",
    "fixtures:record": "tsx tools/record-fixtures.ts",
    "verify:f1": "tsx tools/verify-f1.ts",
    "ingest:seed": "tsx tools/run-seed-ingest.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "pg": "8.23.0",
    "pg-boss": "12.30.0",
    "robots-parser": "3.0.1",
    "tldts": "7.4.12",
    "undici": "7.29.1",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@types/node": "22.20.1",
    "@types/pg": "8.23.1",
    "dotenv": "17.4.2",
    "eslint": "10.10.0",
    "prisma": "7.10.0",
    "tsx": "4.23.13",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.0",
    "vitest": "4.1.11"
  },
  "allowScripts": {
    "prisma@7.10.0": true,
    "@prisma/engines@7.10.0": true,
    "esbuild@0.28.2": true,
    "fsevents@2.3.3": true
  }
}
