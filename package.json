{
  "name": "outreach-intelligence",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.backend.json && tsc --noEmit",
    "lint": "eslint .",
    "check:no-raw-http": "tsx tools/check-no-raw-http.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:reset": "prisma migrate reset --force",
    "test": "npm run check:no-raw-http && vitest run",
    "test:watch": "vitest",
    "verify:f0": "tsx tools/verify-f0.ts",
    "seed:hosts": "tsx tools/seed-host-policies.ts",
    "fixtures:record": "tsx tools/record-fixtures.ts",
    "verify:f1": "tsx tools/verify-f1.ts",
    "ingest:seed": "tsx tools/run-seed-ingest.ts",
    "llm:list": "tsx tools/llm.ts list",
    "llm:next": "tsx tools/llm.ts next",
    "llm:fulfil": "tsx tools/llm.ts fulfil",
    "llm:reject": "tsx tools/llm.ts reject",
    "llm:kinds": "tsx tools/llm.ts kinds",
    "seed:tracks": "tsx tools/seed-role-tracks.ts",
    "intel:run": "tsx tools/run-intelligence.ts",
    "verify:f2": "tsx tools/verify-f2.ts",
    "seed:budget": "tsx tools/seed-global-budget.ts",
    "seed:operator": "tsx tools/seed-operator-data.ts",
    "packets:run": "tsx tools/run-packets.ts",
    "verify:f3": "tsx tools/verify-f3.ts",
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "contacts:curate": "tsx tools/run-contacts.ts",
    "drafts:run": "tsx tools/run-drafts.ts",
    "verify:f4": "tsx tools/verify-f4.ts"
  },
  "dependencies": {
    "@mozilla/readability": "0.6.0",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "linkedom": "0.18.13",
    "next": "16.3.4",
    "pg": "8.23.0",
    "pg-boss": "12.30.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "robots-parser": "3.0.1",
    "tldts": "7.4.12",
    "undici": "7.29.1",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@types/node": "22.20.1",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "dotenv": "17.4.2",
    "eslint": "10.10.0",
    "prisma": "7.10.0",
    "tsx": "4.23.13",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.0",
    "vitest": "4.1.11"
  },
  "allowScripts": {
    "prisma@7.10.0": true,
    "@prisma/engines@7.10.0": true,
    "esbuild@0.28.2": true,
    "fsevents@2.3.3": true
  }
}
