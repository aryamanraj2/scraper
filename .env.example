# --- Database -------------------------------------------------------------
DATABASE_URL="postgresql://USER@localhost:5432/outreach_dev"
TEST_DATABASE_URL="postgresql://USER@localhost:5432/outreach_test"

# --- Secret store (A5) ----------------------------------------------------
# Local dev + production read the key-encryption key from the macOS Keychain.
# KEY_PROVIDER=keychain uses `security find-generic-password`; no key material
# ever lands in this file or in Postgres.
KEY_PROVIDER="keychain"
KEYCHAIN_SERVICE="outreach-intelligence"
KEYCHAIN_ACCOUNT="kek"
# KEY_PROVIDER=env is for tests and CI ONLY. It is refused outside NODE_ENV=test.
# OUTREACH_KEK_BASE64=

# Salt for Suppression.email_hmac (A10). Rotating this orphans every existing
# suppression, so it is write-once in practice.
SUPPRESSION_HMAC_SALT=""

# --- Sending --------------------------------------------------------------
# Setting this to true does NOT enable sending before F5. See src/core/config/stage.ts:
# sending additionally requires MILESTONE_STAGE >= F5 and no engaged kill switch.
SENDING_ENABLED="false"

# --- Research escalation (D4 tier 3, B6a) ---------------------------------
# Firecrawl. Leave unset to disable escalation entirely: the pipeline is correct
# without it, and the signal graph simply never returns a tier-3 action.
# Free tier is 1,000 credits/month (~230 companies at weekly cadence); the student
# programme grants 10,000. A plain scrape costs 1 credit.
# FIRECRAWL_API_KEY=

# --- Fetch policy ---------------------------------------------------------
USER_AGENT="outreach-intelligence-research/0.1 (+https://example.invalid/about)"
ROBOTS_CACHE_TTL_SECONDS="86400"
DEFAULT_HOST_RATE_DELAY_MS="5000"

# Gmail OAuth (F5). Create a Desktop app client in Google Cloud Console.
GMAIL_OAUTH_CLIENT_ID=""
GMAIL_OAUTH_CLIENT_SECRET=""
